    color: #7f8c8d;
}
QPushButton#botaoLimpar:hover {
    background-color: #dfe6e9;
}
QTableWidget {
    border: 1px solid #d0d3d8;
    border-radius: 4px;
    gridline-color: #ecf0f1;
    background-color: #ffffff;
}
QTableWidget::item {
    padding: 4px;
}
QHeaderView::section {
    background-color: #f0f2f5;
    border: none;
    border-bottom: 1px solid #d0d3d8;
    border-right: 1px solid #d0d3d8;
    padding: 5px;
    font-weight: bold;
    color: #2c3e50;
}
QLabel#labelTMR, QLabel#labelTME, QLabel#labelPageFaults {
    font-size: 13px;
    padding: 6px 10px;
    background-color: #f8f9fa;
    border: 1px solid #e0e3e8;
    border-radius: 4px;
    color: #2c3e50;
}
QTextEdit {
    border: 1px solid #d0d3d8;
    border-radius: 4px;
    font-family: monospace;
    font-size: 12px;
    background-color: #fafbfc;
}
QSpinBox, QComboBox {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px 6px;
    background-color: white;
    min-height: 24px;
}
QTabWidget::pane {
    border: 1px solid #d0d3d8;
    border-radius: 4px;
    background: white;
}
QTabBar::tab {
    padding: 6px 16px;
    border: 1px solid #d0d3d8;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background: #ecf0f1;
    color: #7f8c8d;
}
QTabBar::tab:selected {
    background: white;
    color: #2c3e50;
    font-weight: bold;
}
QScrollArea {
    border: none;
}
